# ---------------------------------------------------------------------------
# Lets-Tour environment template.
# Copy to `.env` and fill with REAL values. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1/lets-tour

# --- Core Payload / Next ----------------------------------------------------
# Random string used to encrypt JWT tokens / sessions
PAYLOAD_SECRET=CHANGE_ME
# Public server URL, no trailing slash (used for CORS, links, sitemaps)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron / background jobs
CRON_SECRET=CHANGE_ME
# Secret used to validate draft-preview requests
PREVIEW_SECRET=CHANGE_ME

# --- Initial admin seed (optional) ------------------------------------------
# If BOTH are set AND the users collection is empty on boot, an admin user is
# created automatically. Leave blank to skip seeding (create the first user
# via the /admin UI instead).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Email (Zoho SMTP via Nodemailer) ---------------------------------------
SMTP_HOST=smtppro.zoho.in
ZOHO_USER=you@example.com
# Use a Zoho App Password, not your account password
ZOHO_PASS=CHANGE_ME
# Where new-lead notification emails are sent (defaults to ZOHO_USER)
LEAD_NOTIFICATION_EMAIL=

# --- Media storage (Vercel Blob) --------------------------------------------
BLOB_READ_WRITE_TOKEN=CHANGE_ME

# --- Media storage (S3 — optional, adapter currently disabled in config) -----
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# --- Payments (Razorpay) ----------------------------------------------------
# Hard deploy-level master switch. Keep 'false' until keys + webhook are verified.
# The admin "Payment Settings" global is the day-to-day on/off toggle; BOTH must
# be enabled (and keys present) for any charge to be created.
PAYMENTS_ENABLED=false
# Informational only — which key set this deployment uses (test | live)
RAZORPAY_MODE=test
# Razorpay API keys (Dashboard → Settings → API Keys). Secrets stay in env, never in the DB.
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
# Webhook signing secret (Dashboard → Settings → Webhooks). Used to verify webhook calls.
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
# Public key id exposed to the browser for on-site Checkout (safe to expose; NOT the secret)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
